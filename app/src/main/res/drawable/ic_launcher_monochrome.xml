<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ 主题图标（Themed Icon）：只保留 WK 两个字母的轮廓，不带白牌。

  系统按 drawable 的 alpha 通道染成单色，所以这里的颜色取值不重要、但必须完全不透明；
  之前 monochrome 直接复用彩色 PNG 前景，染色后会发虚，这一版不再复用。
  group 把字母整体放大 1.25 倍并绕画布中心缩放，单色小图标下仍能读出两个字母；
  放大后的笔画外沿约 34.7，仍在圆形遮罩半径 36 内。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.25"
        android:scaleY="1.25"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:fillColor="@android:color/transparent"
            android:pathData="M32,41.7 L35.3,66.3 L40.8,52.5 L46.3,66.3 L49.6,41.7"
            android:strokeColor="#FF000000"
            android:strokeWidth="6.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:fillColor="@android:color/transparent"
            android:pathData="M56.6,41.7 L56.6,66.3 M59.1,54 L74.2,41.7 M59.1,54 L74.2,66.3"
            android:strokeColor="#FF000000"
            android:strokeWidth="6.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
